{
  "name": "ponderum",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/client",
    "dev:client": "npm run dev --workspace apps/client",
    "dev:manager": "npm run dev --workspace apps/manager",
    "build": "npm run build --workspace apps/client",
    "build:client": "npm run build --workspace apps/client",
    "build:manager": "npm run build --workspace apps/manager",
    "build:dev": "npm run build:dev --workspace apps/client",
    "lint": "npm run lint --workspace apps/client",
    "preview": "npm run preview --workspace apps/client",
    "test": "npm run test --workspace apps/client",
    "test:watch": "npm run test:watch --workspace apps/client",
    "test:coverage": "npm run test:coverage --workspace apps/client",
    "typecheck": "npm run typecheck --workspace apps/client"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@supabase/supabase-js": "^2.105.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^22.16.5",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react-swc": "^4.3.1",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^8.1.4"
  }
}
